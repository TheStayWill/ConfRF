<%- include('header') %>

<div class="row justify-content-center">
  <div class="col-md-8 col-12">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1 class="mb-0">Заявка №<%= request.id %></h1>
      <a href="<%= isAdmin ? '/admin' : '/dashboard' %>" class="btn btn-outline-secondary">Назад к заявкам</a>
    </div>

    <div class="card mb-3">
      <div class="card-body">
        <p class="mb-2">
          <b>Статус:</b>
          <span class="badge bg-<%= request.status === 'Новая' ? 'secondary' :
              request.status === 'Мероприятие назначено' ? 'primary' : 'success' %>"><%= request.status %></span>
        </p>
        <p class="mb-1"><b>Дата начала:</b> <%= request.date_start %></p>
        <p class="mb-1"><b>Оплата:</b> <%= request.payment %></p>
        <p class="mb-0"><b>Создана:</b> <%= request.created_at %></p>
      </div>
    </div>

    <div class="card mb-3">
      <div class="card-header">Помещение</div>
      <div class="card-body">
        <p class="mb-1"><b>Название:</b> <%= request.room_name %></p>
        <p class="mb-1"><b>Тип:</b> <%= request.room_type %></p>
        <p class="mb-0"><b>Вместимость:</b> <%= request.room_capacity %> чел.</p>
      </div>
    </div>

    <% if (isAdmin) { %>
    <div class="card mb-3">
      <div class="card-header">Пользователь</div>
      <div class="card-body">
        <p class="mb-1"><b>ФИО:</b> <%= request.user_fio %></p>
        <p class="mb-1"><b>Логин:</b> <%= request.user_login %></p>
        <p class="mb-1"><b>Email:</b> <%= request.user_email %></p>
        <p class="mb-0"><b>Телефон:</b> <%= request.user_phone %></p>
      </div>
    </div>
    <% } %>

    <% if (request.review) { %>
    <div class="card mb-3">
      <div class="card-header">Отзыв</div>
      <div class="card-body"><%= request.review %></div>
    </div>
    <% } else if (isOwner && request.status === 'Завершено') { %>
    <div class="card mb-3">
      <div class="card-header">Оставить отзыв</div>
      <div class="card-body">
        <form action="/review/<%= request.id %>" method="post">
          <div class="mb-3">
            <textarea class="form-control" name="review" rows="4" required placeholder="Как прошло мероприятие?"></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Отправить отзыв</button>
        </form>
      </div>
    </div>
    <% } %>
  </div>
</div>

<%- include('footer') %>