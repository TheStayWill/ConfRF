<div class="container">
    <div class="d-flex algin-items-center justify-content-center">
        <div class="shadow card mt-5" style="max-width: 28rem; width: 100%;">
            <div class="card-body">
                <h1 class="h2"><%= title %></h1>
                <form method="POST" action="/register">
                <input class="form-control mt-3" name="login" placeholder="Придумайте логин">
                <input class="form-control mt-3" name="name" placeholder="Иван Иванов Иванович">
                <input class="form-control mt-3" name="email" type="email" placeholder="example@email.com">
                <input class="form-control mt-3" name="phone" placeholder="+7 999 999-99-99">
                <input class="form-control mt-3" name="password" type="password" placeholder="Пароль">
                <button class="mt-3 btn btn-secondary">Создать пользователя</button>
                </form>
            </div>
        </div>
    </div>
</div>


